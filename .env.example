# ── Copy to .env and fill in values ──────────────────────────────────────────

# Django
SECRET_KEY=your-super-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:3000

# PostgreSQL
POSTGRES_DB=stayfinder
POSTGRES_USER=stayfinder
POSTGRES_PASSWORD=stayfinder
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis & Celery
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0

# Cloudinary (optional — falls back to local storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (optional — prints to console if not set)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=noreply@stayfinder.com

# CORS (for production)
CORS_ORIGINS=https://yoursite.com

# Frontend
VITE_SITE_URL=http://localhost:3000
