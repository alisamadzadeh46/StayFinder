# ═══════════════════════════════════════════════════════
#  StayFinder — .gitignore
# ═══════════════════════════════════════════════════════

# ── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
.Python

# ── Virtual environments ─────────────────────────────────
venv/
env/
.venv/
ENV/

# ── Django ───────────────────────────────────────────────
*.log
db.sqlite3
db.sqlite3-journal
media/
staticfiles/
static/frontend/

# NOTE: migrations are intentionally TRACKED
# They are needed for `docker-compose up` to work without
# running makemigrations manually.
# Do NOT add migrations/ to this file.

# ── Environment variables ────────────────────────────────
.env
.env.local
.env.*.local
*.env
# Keep .env.example tracked (it's a template)
!.env.example

# ── Node / Frontend ──────────────────────────────────────
node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Keep package-lock.json tracked — needed for npm ci in Docker
!frontend/package-lock.json

# ── Docker ───────────────────────────────────────────────
docker-compose.override.yml

# ── Editors ──────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Secrets ──────────────────────────────────────────────
*.pem
*.key
*.cert
secrets.json

# ── Misc ─────────────────────────────────────────────────
*.zip
*.tar.gz
